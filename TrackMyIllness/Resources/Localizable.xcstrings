    "Closing an illness files the current log away — you can still read and export it — and starts the Report and History tabs clean.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En tancar una malaltia, el registre actual s'arxiva —el podràs continuar llegint i exportant— i les pestanyes Registrar i Històric comencen buides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abschließen einer Krankheit wird das aktuelle Protokoll archiviert – du kannst es weiterhin lesen und exportieren – und die Tabs „Erfassen“ und „Verlauf“ starten leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar una enfermedad, el registro actual se archiva —podrás seguir leyéndolo y exportándolo— y las pestañas Registrar e Histórico empiezan vacías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturer une maladie archive le journal actuel — vous pourrez toujours le consulter et l'exporter — et les onglets Signaler et Historique repartent à vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo una malattia il registro attuale viene archiviato — potrai comunque leggerlo ed esportarlo — e le schede Registra e Cronologia ripartono vuote."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao fechares uma doença, o registo atual é arquivado — podes continuar a lê-lo e a exportá-lo — e os separadores Registar e Histórico começam vazios."
          }
        }
      }
    },
