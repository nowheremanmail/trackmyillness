    },
    "Your treatments and symptoms are deleted too, leaving the app as it was on day one. Entries already archived keep their names.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "També s'eliminen els teus tractaments i símptomes, i l'app queda com el primer dia. Els registres ja arxivats conserven els seus noms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Behandlungen und Symptome werden ebenfalls gelöscht – die App ist dann wie am ersten Tag. Bereits archivierte Einträge behalten ihre Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminan tus tratamientos y síntomas, y la app queda como el primer día. Los registros ya archivados conservan sus nombres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos traitements et symptômes sont également supprimés, l'app revient à son premier jour. Les entrées déjà archivées gardent leurs noms."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono eliminati anche i tuoi trattamenti e sintomi, e l'app torna come il primo giorno. Le voci già archiviate mantengono i loro nomi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus tratamentos e sintomas também são eliminados e a app fica como no primeiro dia. Os registos já arquivados mantêm os nomes."
          }
        }
      }
    },
    "Your treatments and symptoms stay configured, ready for whatever you track next.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
