    },
    "Your entries are grouped by day, with a chart of how the days compare. Any period exports as a PDF for an appointment.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus registres s'agrupen per dia, amb un gràfic per comparar. Qualsevol període s'exporta a PDF per a una cita."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einträge sind nach Tag gruppiert, mit einem Diagramm zum Vergleich. Jeder Zeitraum lässt sich als PDF für einen Termin exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros se agrupan por día, con un gráfico para comparar. Cualquier periodo se exporta a PDF para una cita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos entrées sont regroupées par jour, avec un graphique de comparaison. Toute période s'exporte en PDF pour un rendez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue voci sono raggruppate per giorno, con un grafico di confronto. Qualsiasi periodo si esporta in PDF per una visita."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus registos são agrupados por dia, com um gráfico para comparar. Qualquer período exporta-se em PDF para uma consulta."
          }
        }
      }
    },
    "Your log stays on this device.": {
      "extractionState": "manual",
      "localizations": {
