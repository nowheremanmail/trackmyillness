    "Everything an illness creates is an ordinary treatment or symptom afterwards — rename it, recolour it or remove it as you like.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot el que crea una malaltia queda després com un tractament o símptoma normal: pots canviar-li el nom, el color o esborrar-lo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was eine Krankheit anlegt, ist danach eine normale Behandlung oder ein normales Symptom – umbenennen, umfärben oder löschen, wie du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que crea una enfermedad queda después como un tratamiento o síntoma normal: puedes renombrarlo, cambiarle el color o borrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu'une maladie crée devient ensuite un traitement ou un symptôme ordinaire : renommez-le, changez sa couleur ou supprimez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che crea una malattia diventa poi un normale trattamento o sintomo: rinominalo, cambiane il colore o eliminalo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que uma doença cria fica depois como um tratamento ou sintoma normal: podes renomeá-lo, mudar a cor ou apagá-lo."
          }
        }
      }
    },
