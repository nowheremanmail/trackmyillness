    },
    "Tap what happened and save. The date starts at today and the time at now, with shortcuts for a while ago.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca què ha passat i desa. La data comença a avui i l'hora a ara, amb dreceres per a fa una estona."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe an, was passiert ist, und speichere. Datum ist heute, Uhrzeit ist jetzt – mit Kurzbefehlen für vorhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca lo que ha pasado y guarda. La fecha empieza en hoy y la hora en ahora, con atajos para hace un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ce qui s'est passé et enregistrez. La date part d'aujourd'hui et l'heure de maintenant, avec des raccourcis pour tout à l'heure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca che cosa è successo e salva. La data parte da oggi e l'ora da adesso, con scorciatoie per poco fa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca no que aconteceu e guarda. A data começa em hoje e a hora em agora, com atalhos para há pouco."
          }
        }
      }
    },
    "The app locks when it goes to the background and asks to unlock the next time you open it.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app es bloca quan passa a segon pla i demana desblocar-la el següent cop que l'obris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App sperrt sich im Hintergrund und fragt beim nächsten Öffnen nach der Entsperrung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se bloquea al pasar a segundo plano y pide desbloquearla la próxima vez que la abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app se verrouille en arrière-plan et demande à être déverrouillée à la prochaine ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app si blocca quando passa in background e chiede di sbloccarla alla riapertura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A app bloqueia-se ao passar para segundo plano e pede para a desbloquear na próxima abertura."
          }
        }
      }
    },
    "The log is archived, not deleted — you can read it and export it at any time. The Report and History tabs start empty.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El registre s'arxiva, no s'esborra: el podràs llegir i exportar quan vulguis. Les pestanyes Registrar i Històric comencen buides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll wird archiviert, nicht gelöscht – du kannst es jederzeit lesen und exportieren. Die Tabs „Erfassen“ und „Verlauf“ starten leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro se archiva, no se borra: podrás leerlo y exportarlo cuando quieras. Las pestañas Registrar e Histórico empiezan vacías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal est archivé, pas supprimé : vous pourrez le consulter et l'exporter à tout moment. Les onglets Signaler et Historique repartent à vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il registro viene archiviato, non eliminato: potrai leggerlo ed esportarlo quando vuoi. Le schede Registra e Cronologia ripartono vuote."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O registo é arquivado, não apagado: podes lê-lo e exportá-lo quando quiseres. Os separadores Registar e Histórico começam vazios."
          }
        }
      }
    },
    "The ones you already have are left untouched.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els que ja tens es queden com estan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du schon hast, bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los que ya tienes se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceux que vous avez déjà restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelli che hai già restano invariati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os que já tens ficam como estão."
          }
        }
      }
    },
    "The published list couldn't be read.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut llegir la llista publicada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die veröffentlichte Liste konnte nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la lista publicada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste publiée n'a pas pu être lue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco pubblicato non è stato letto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a lista publicada."
          }
        }
      }
    },
    "Therapy session": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
