    "No account, no tracking, nothing uploaded. You can lock the app with Face ID from Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense compte, sense seguiment, res no es puja. Pots blocar l'app amb Face ID des de Configuració."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, kein Tracking, nichts wird hochgeladen. Du kannst die App in den Einstellungen mit Face ID sperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin seguimiento, nada se sube. Puedes bloquear la app con Face ID desde Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de suivi, rien n'est envoyé. Vous pouvez verrouiller l'app avec Face ID depuis les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessun tracciamento, niente viene caricato. Puoi bloccare l'app con Face ID da Impostazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem rastreio, nada é enviado. Podes bloquear a app com Face ID em Configuração."
          }
        }
      }
    },
