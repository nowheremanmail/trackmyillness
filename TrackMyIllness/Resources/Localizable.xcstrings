    "Pick an illness and the treatments and symptoms usually tracked for it are created for you. You can edit or remove any of them.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una malaltia i es creen els tractaments i símptomes que se solen registrar. Pots editar-los o esborrar-los."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Krankheit, und die üblichen Behandlungen und Symptome werden für dich angelegt. Du kannst sie bearbeiten oder löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una enfermedad y se crean los tratamientos y síntomas que se suelen registrar. Puedes editarlos o borrarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une maladie et les traitements et symptômes habituels sont créés pour vous. Vous pouvez les modifier ou les supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una malattia e trattamenti e sintomi tipici vengono creati per te. Puoi modificarli o eliminarli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma doença e os tratamentos e sintomas habituais são criados para ti. Podes editá-los ou removê-los."
          }
        }
      }
    },
