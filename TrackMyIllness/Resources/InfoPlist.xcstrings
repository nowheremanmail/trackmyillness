    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Symptrace demana el Face ID abans de mostrar el teu registre de salut, perquè els tractaments i símptomes que has anotat continuïn sent privats si una altra persona agafa el teu dispositiu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symptrace fragt nach Face ID, bevor es dein Gesundheitsprotokoll anzeigt, damit die erfassten Behandlungen und Symptome privat bleiben, wenn jemand anderes dein Gerät in die Hand nimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Symptrace asks for Face ID before it shows your health log, so the treatments and symptoms you have recorded stay private if someone else picks up your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Symptrace pide Face ID antes de mostrar tu registro de salud, para que los tratamientos y síntomas que has anotado sigan siendo privados si otra persona coge tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Symptrace demande Face ID avant d'afficher votre journal de santé, afin que les traitements et symptômes que vous avez notés restent privés si quelqu'un d'autre prend votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Symptrace chiede il Face ID prima di mostrare il tuo diario di salute, così i trattamenti e i sintomi che hai registrato restano privati se qualcun altro prende il tuo dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Symptrace pede o Face ID antes de mostrar o teu registo de saúde, para que os tratamentos e sintomas que registaste continuem privados se outra pessoa pegar no teu dispositivo."
          }
        }
      }
    }
  },
  "version": "1.0"
}
