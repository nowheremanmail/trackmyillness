<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store Connect distribution. Used by Tools/archive.sh. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>W37STSLM78</string>
	<!-- Let Xcode create and download the distribution certificate and profile. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Ship the dSYMs so App Store Connect can symbolicate crash reports. -->
	<key>uploadSymbols</key>
	<true/>
	<!-- No bitcode on iOS any more, and no App Store thinning at export time. -->
	<key>destination</key>
	<string>export</string>
	<!-- Off, so the .ipa carries exactly the build number in project.pbxproj.
	     For App Store distribution this defaults to true, and Xcode silently
	     rewrites the build number during export — the archive said 3 and the
	     exported .ipa said 4, which would make the repository and any release
	     note disagree with the store forever. Bumping is a deliberate step; see
	     AppStore/CHECKLIST.md. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
